{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["schema"],
    "properties": {
        "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1
        },
        "questions": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["key", "type", "prompt"],
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": ["text"]
                    },
                    "prompt": {
                        "type": "string"
                    },
                    "default": {
                        "type": "string"
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "validation": {
                        "type": "object",
                        "properties": {
                            "pattern": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        },
        "files": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["source", "target", "mode"],
                "properties": {
                    "source": {
                        "type": "string"
                    },
                    "target": {
                        "type": "string"
                    },
                    "mode": {
                        "type": "string",
                        "enum": ["render", "copy"]
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
