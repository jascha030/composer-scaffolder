{
  "$schema": "phpactor.schema.json",
  "language_server_phpstan.bin": "%project_root%/vendor/bin/phpstan",
  "language_server_phpstan.config": "%project_root%/phpstan.neon.dist",
  "language_server_php_cs_fixer.bin": "%project_root%/vendor/bin/php-cs-fixer",
  "language_server_php_cs_fixer.config": "%project_root%/.php-cs-fixer.dist.php",
  "language_server_phpstan.enabled": true,
  "language_server.diagnostic_ignore_codes": [
    "worse.missing_member",
    "worse.unresolved_name"
  ],
  "composer.autoloader_path": [
    "%project_root%/vendor/autoload.php",
    "%project_root%/tools/phpunit.phar",
    "%project_root%/vendor-bin/php-cs-fixer/vendor/autoload.php"
  ]
}
